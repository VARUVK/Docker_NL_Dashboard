# GEMINI_API_KEY: Optional for Gemini-powered intent translation and commentary.
# If omitted, configure Ollama instead or use the app in limited fallback mode.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional deployment URL if the app is hosted remotely.
APP_URL="MY_APP_URL"

# OLLAMA_URL / OLLAMA_MODEL: Optional local or remote Ollama configuration.
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3"
