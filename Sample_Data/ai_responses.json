{
  "_comment": "Representative raw outputs from ai_parser.parse_query() for the sample queries. Demonstrates that both the Claude API path and the keyword fallback produce the same structured JSON action schema consumed by app.py.",
  "responses": [
    { "input": "Show all running containers",                 "output": { "action": "list_containers", "status": "running" } },
    { "input": "Show stopped containers",                      "output": { "action": "list_containers", "status": "exited" } },
    { "input": "Show containers that are restarting",          "output": { "action": "list_containers", "status": "restarting" } },
    { "input": "Which containers crashed in the last hour?",   "output": { "action": "crashed_containers", "hours": 1 } },
    { "input": "Which containers crashed in the last 6 hours?","output": { "action": "crashed_containers", "hours": 6 } },
    { "input": "How many containers are active?",              "output": { "action": "count_containers", "status": "running" } },
    { "input": "How many total containers do I have?",         "output": { "action": "count_containers", "status": "all" } },
    { "input": "Show docker health overview",                  "output": { "action": "health_overview" } },
    { "input": "Show unhealthy containers",                    "output": { "action": "list_containers", "status": "unhealthy" } },
    { "input": "Show logs of nginx",                           "output": { "action": "show_logs", "container": "nginx", "tail": 50 } },
    { "input": "Show last 100 lines of logs for web",          "output": { "action": "show_logs", "container": "web", "tail": 100 } },
    { "input": "Find containers named web",                    "output": { "action": "search_containers", "query": "web" } },
    { "input": "List all containers",                          "output": { "action": "list_containers", "status": "all" } },
    { "input": "asldkfj nonsense",                             "output": { "action": "unknown", "raw": "asldkfj nonsense" } }
  ]
}
